# ReachInbox backend configuration.
# Copy to `.env` and fill in. NEVER commit the real `.env` — it holds secrets.

NODE_ENV=development
PORT=8010

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/reachinbox?schema=public
# Signs app JWTs. Generate a long random value for production.
JWT_SECRET=change-me-in-production

# --- Redis / queue ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# --- CORS -------------------------------------------------------------------
# "*" allows any origin; set an explicit origin in production.
FRONTEND_URL=*

# --- Email provider ---------------------------------------------------------
# Ethereal is a development-only sandbox; no real mail is delivered.
# Leave ETHEREAL_USER/PASSWORD blank to auto-create a test account on first send.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# --- Supabase (Google + email/password auth) --------------------------------
# Required for real sign-in. Without these, only dev-login works.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# WARNING: bypasses row-level security. Server-side only — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Slack integration (optional) -------------------------------------------
# Required for the one-click "Connect Slack" OAuth flow.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match the redirect URL registered in the Slack app exactly.
SLACK_REDIRECT_URI=http://localhost:8010/api/auth/slack/oauth/callback
# Frontend origin used for the post-callback browser redirect.
APP_PUBLIC_URL=http://localhost:3000

# --- Elasticsearch (optional) -----------------------------------------------
# Leave blank to disable search; it falls back to PostgreSQL.
ELASTICSEARCH_URL=http://127.0.0.1:9200

# --- Attachment object storage (required for a multi-service deployment) -----
# The API writes attachments and the worker reads them. As separate services they
# do NOT share a filesystem, so object storage is required in production.
# Works with AWS S3, Cloudflare R2, Supabase Storage, MinIO, etc.
# Leave S3_BUCKET blank to fall back to local disk (development only).
S3_BUCKET=
S3_REGION=auto
# Set for R2 / MinIO / Supabase Storage; leave blank for AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "true" for MinIO and most self-hosted gateways.
S3_FORCE_PATH_STYLE=false

# --- Bull Board (queue dashboard at /api/admin/queues) ----------------------
# CHANGE THESE — the defaults are public knowledge.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Development sign-in (SECURITY) -----------------------------------------
# Dev sign-in issues a valid token for ANY email with no credential check.
# It is OFF automatically when NODE_ENV=production. Only set this to "true" on a
# throwaway local environment — never on anything publicly reachable.
DEV_LOGIN_ENABLED=

# --- Direct Google OAuth (NOT IMPLEMENTED) ----------------------------------
# GET /api/auth/google returns 501. Google sign-in works via Supabase instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
