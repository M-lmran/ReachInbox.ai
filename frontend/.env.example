# ReachInbox frontend configuration.
# Copy to `.env`. CRA inlines REACT_APP_* at BUILD time — restart the dev server
# after changing any of these.

# Backend API base URL.
REACT_APP_BACKEND_URL=http://localhost:8010

# Supabase — must match SUPABASE_URL / SUPABASE_ANON_KEY in server/.env.
# The anon key is designed for browser use; the service_role key must NEVER go here.
# Leave blank to keep dev sign-in as the only login path.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
