# react-day-picker@8 declares a peer of date-fns@^2 || ^3, while this project pins
# date-fns@4. npm 7+ treats that as a hard conflict and aborts the install:
#
#   npm error ERESOLVE unable to resolve dependency tree
#
# Every host that builds this package therefore needs legacy peer resolution.
# Committing this file makes a plain `npm install` work on Vercel, Render and CI
# without needing an explicit --legacy-peer-deps flag.
legacy-peer-deps=true
